# Vorlage fuer die Umgebungsvariablen des PTI-Pseudonymisierers.
#
# ACHTUNG: Presidios eigene .env liegt ebenfalls im Root und ist upstream
# getrackt — sie gehoert NICHT uns und wird nicht angefasst. Unsere Werte
# kommen in Produktion aus dem Jelastic-Dashboard, lokal aus einer .env, die
# ueber ENV_FILE referenziert wird.
#
# Nach JEDER Aenderung im Jelastic-Dashboard: Dashboard-Restart.
# Ein blosser Prozess-Restart uebernimmt die Variablen nicht.

# ── Laufzeit ───────────────────────────────────────────────────────────────
ENV=production              # production | development — steuert HTTPS-Redirect
PORT=8000
# Anzahl gunicorn-Worker. Default 2 — so laeuft der Regelbetrieb.
# Nur fuer die Ein-Knoten-Rueckfallvariante (JELASTIC_SETUP.md 1b) auf 1 setzen:
# das halbiert den Speicherbedarf auf rund 500 MB, denn das spaCy-Modell allein
# kostet 411 MB je Worker.
# WEB_CONCURRENCY=1

# ── Datenbank ──────────────────────────────────────────────────────────────
# Eigene DB, bewusst NICHT die geteilte pti-db: Vault-Ciphertext gehoert nicht
# in die CRM-Datenbank. Jelastic-PG erzwingt SSL (hostssl in pg_hba).
DATABASE_URL=postgresql+psycopg://webadmin:CHANGEME@localhost:5432/pti_pseudonymisierer?sslmode=require

# Rueckfallvariante auf einem einzigen Knoten, ohne PostgreSQL
# (JELASTIC_SETUP.md 1b) — nicht der geplante Betriebszustand:
# Vier Schraegstriche — drei fuers Schema, einer fuer den absoluten Pfad.
# Die Datei MUSS ausserhalb des Deploy-Roots liegen, sonst loescht sie das
# naechste VCS-Update.
# DATABASE_URL=sqlite:////home/jelastic/pti-pseudonymisierer.db

# ── TIP-Hub SSO (Ansatz B) ─────────────────────────────────────────────────
CRM_BASE_URL=https://crm.pti-tip-hub.ch
HUB_BASE_URL=https://pti-tip-hub.ch
HUB_APP_KEY=pseudonymizer   # geprueftes Flag aus session.apps — muss zur CRM-Spalte passen
RELAY_SECRET=               # identisch zu CRM und Hub. Rate-Limit-Bypass, KEIN Auth-Faktor.
PUBLIC_BASE_URL=https://pseudo.pti-tip-hub.ch

# Lokale Entwicklung ohne CRM: Gate abschalten, synthetischer Admin.
# DEV_ROLE=standard prueft den Verweigerungspfad.
# HUB_AUTH=off
# DEV_ROLE=admin

# ── Vault ──────────────────────────────────────────────────────────────────
# 32 Byte hex: openssl rand -hex 32
# VERLUST = ALLE VAULTS UNWIEDERBRINGLICH UNLESBAR. Gehoert zusaetzlich in den
# Passwortmanager, nicht nur ins Jelastic-Panel.
VAULT_MASTER_KEY=

# ── Engine ─────────────────────────────────────────────────────────────────
# Muss zum Modell-Wheel in pti-requirements.txt passen (beide gleichzeitig aendern).
# Gemessen 2026-08-18: de_core_news_md = 406 MB RSS je Worker, Ladezeit 1.1 s,
# Durchsatz ~16'000 Zeichen/s. de_core_news_lg liegt bei rund dem Doppelten.
SPACY_MODEL=de_core_news_md
LLM_PROVIDER=none           # none | infomaniak | local  — Phase 3

# KI-Schicht (Phase 3). Noch wertet kein Code diese Werte aus.
#
# Schluessel UND Produkt-Id werden gebraucht: Die Produkt-Id steht im *Pfad*
# der Anfrage ({base}/2/ai/{product_id}/openai/v1/chat/completions), der
# Bearer-Token authentisiert nur. Namen absichtlich identisch zu `pti-rag`,
# wo die Anbindung bereits laeuft.
#
# Der Token ist je Umgebung eigen: pti-pseudo und pti-rag sind getrennte
# Jelastic-Umgebungen mit getrennten Variablen. Ein eigener Token fuer dieses
# Werkzeug ist also der Normalfall, kein Zusatzaufwand.
# INFOMANIAK_AI_KEY=
# INFOMANIAK_AI_PRODUCT_ID=
# INFOMANIAK_AI_BASE=https://api.infomaniak.com
# INFOMANIAK_AI_MODELL=swiss-ai/Apertus-v1.5-70B
#
# Betriebsschalter der Zweitmeinung (Stufe D, backend/ki/zweitmeinung.py).
# Sie ist die einzige Stufe, bei der der VOLLSTAENDIGE Dokumenttext hinausgeht
# — maskiert, also ohne jeden erkannten Namen, aber mit dem ganzen Sachverhalt.
#
# Vorgabe AUS, und das ist gemessen: Am 2026-08-25 senkte sie die Precision von
# 93.2 % auf 87.2 %, verdreifachte die Anfragen je Dokument und fand im
# Golden-Set nichts Nachweisbares. Zuschalten lohnt erst, wenn die Anfragezahl
# gesenkt ist. Auf dem Knoten wirkt sie nur, weil sie in der Export-Liste von
# deploy/pythonenv steht — der Runner liest /.jelenv, exportiert aber nicht.
# KI_ZWEITMEINUNG=off

# ── Grenzen ────────────────────────────────────────────────────────────────
# MAX_UPLOAD_BYTES muss zu client_max_body_size im NGINX des Knotens passen
# (Default dort ist 1 MB — sonst 413 statt einer sauberen Fehlermeldung).
MAX_UPLOAD_BYTES=26214400   # 25 MiB
# Ab dieser Groesse wird nicht mehr synchron verarbeitet. Bei ~16k Zeichen/s
# laeuft ein grosses Dokument sonst in den Gateway-Timeout.
SYNC_THRESHOLD_BYTES=2097152
